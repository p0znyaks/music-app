{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "repair:durations": "tsx src/scripts/repair-durations.ts",
    "test": "vitest run",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/services/dataSource.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/services/dataSource.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/services/dataSource.ts",
    "test:load": "vitest run --config vitest.load.config.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "5.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.0.0"
  }
}
