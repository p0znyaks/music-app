# Environment - NEVER commit real secrets
.env
.env.*
!.env.example

# Certificates & Keys
*.pem
*.key
*.crt
*.pfx

# But track the specific certs needed for deployment
!backend/server-cert.pem
!backend/server-key.pem
!nginx/certs/server-cert.pem
!nginx/certs/server-key.pem

# Node modules
backend/node_modules/
frontend/app/node_modules/

# Build outputs
backend/dist/
frontend/app/dist/
frontend/app/.angular/

# IDE
.cursor/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Audio cache
audio_cache/

# Certs - only track specific deployed certs
nginx/certs/*
!nginx/certs/server-cert.pem
!nginx/certs/server-key.pem

# Pycache
backend/scripts/__pycache__/