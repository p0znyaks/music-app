# Environment - NEVER commit real secrets
.env
.env.*
!.env.example

# Certificates & Keys
*.pem
*.key
*.crt
*.pfx

# Certificates are generated per machine (see CERT.md) and never committed:
# private keys must not live in the repository.

# Node modules
backend/node_modules/
frontend/app/node_modules/

# Build outputs
backend/dist/
frontend/app/dist/
frontend/app/.angular/

# IDE
.cursor/
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Audio cache
audio_cache/


# Pycache
backend/scripts/__pycache__/

# Test / coverage output
backend/coverage/
frontend/app/coverage/

# YouTube auth cookies: exported manually, must stay out of git (see RUN.md)
cookies.txt

# Local SQL dumps
*.sql

# ESLint / Prettier caches
.eslintcache
node_modules/

# Temporary dirs left behind by cert generation (contain private keys)
.cert-tmp-*/
