# Postgres
POSTGRES_USER=music-app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=music_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql://music-app:change_me@postgres:5432/music_db
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change_me_to_random_string
PORT=3000

# YouTube auth (optional). Cookies are NOT in the repo: export them manually,
# see RUN.md. The file is mounted into the backend at /app/cookies.txt.
YTDLP_COOKIES_FILE=/app/cookies.txt
# Or reuse a local browser profile instead of a cookies file:
# YTDLP_COOKIES_BROWSER=chrome
# YTDLP_BROWSER_CONFIG_PATH=~/.config/google-chrome

# Caching / performance
REDIS_TTL_STREAM_SEC=18000
AUDIO_CACHE_MAX_BYTES=1073741824
PYTHON_WORKERS=2