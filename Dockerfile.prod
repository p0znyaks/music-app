FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/app/package.json frontend/app/package-lock.json* ./
RUN npm ci
COPY frontend/app/angular.json ./angular.json
COPY frontend/app/tsconfig.json ./tsconfig.json
COPY frontend/app/tsconfig.app.json ./tsconfig.app.json
COPY frontend/app/tsconfig.spec.json ./tsconfig.spec.json
COPY frontend/app/src ./src
COPY frontend/app/public ./public
RUN npx ng build

FROM nginx:alpine
COPY --from=builder /app/dist/app/browser /usr/share/nginx/html
COPY nginx/nginx.prod.conf /etc/nginx/nginx.conf
COPY nginx/certs /etc/nginx/certs
COPY backend/server-cert.pem /etc/nginx/certs/server-cert.pem
COPY backend/server-key.pem /etc/nginx/certs/server-key.pem
EXPOSE 1443
CMD ["nginx", "-g", "daemon off;"]